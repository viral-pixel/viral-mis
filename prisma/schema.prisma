// ---- SubModule: "Purchase & Consumption Costing" (Ketan, sub-module 2) ----
// The original source Excel was one wide sheet (one row per month, ~25
// commodity columns). Redesigned 2026-08-29 per the user's real workflow:
// several of the original commodities are analyzed as one combined group
// (Roti/Paratha/Poori/Thepla; the 4 Ramdev Masala items; Gas+Wood; the 4
// Curd items), and each group needs MULTIPLE purchase entries per month
// (different vendors/brands), not just one number — see PurchaseGroup /
// PurchaseEntry below.

// A costing "analysis group" — e.g. Roti/Paratha/Poori/Thepla are tracked
// as ONE group (per user's 2026-08-29 request) even though they're
// physically different items, because the business wants one combined
// figure for analysis. Multiple PurchaseEntry rows per group per month are
// expected and normal (different vendors/brands within the same month).
// Groups that combine several original commodities (Roti/Paratha/Poori/
// Thepla, Masala, Gas & Wood, Curd Items) also need each one pulled out
// individually, not just the combined total — that's what `subItem` on
// PurchaseEntry is for (see below); `remarks` stays free text for
// vendor/brand notes, separate from which physical item an entry is.
model PurchaseGroup {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  unit        String   @default("") // Kg, Ltr, Tin, Nos, Count — blank if amount-only or mixed-unit
  hasAmount   Boolean  @default(true)
  hasQuantity Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Comma-separated list of the physical items this group combines, e.g.
  // "Roti,Paratha,Poori,Thepla" — blank for groups that don't combine
  // anything. Data (not hardcoded), same as everything else editable in
  // this app: Admin can define sub-items for a new group via the Manage
  // Commodities UI, not just the 4 that shipped with the redesign.
  subItemsCsv String   @default("")
  createdAt   DateTime @default(now())

  entries PurchaseEntry[]
}

// One purchase transaction within a month for a group. Several of these
// can exist for the same (month, group) — e.g. three different Rice
// vendors in the same month — and the analysis sums them for that
// month's total. `isDeduction` supports the Gas-bottle case: when the
// kitchen hands its own bottles to a vendor, that entry's amount/quantity
// are SUBTRACTED from the group's monthly total instead of added.
model PurchaseEntry {
  id          Int           @id @default(autoincrement())
  month       DateTime // normalized to the 1st of the month
  groupId     Int
  group       PurchaseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  amount      Float?
  quantity    Float?
  isDeduction Boolean       @default(false)
  // Which physical item this entry is for, when the group combines several
  // (e.g. "Roti" within the Roti/Paratha/Poori/Thepla group). Blank for
  // groups that don't combine anything (Oil, Rice, Sugar, ...) — there's
  // nothing to distinguish. Matched against PurchaseGroupDef.subItems in
  // app/lib/purchaseGroups.ts, not a separate table, since the list is
  // small and fixed per group.
  subItem     String        @default("")
  remarks     String        @default("") // vendor/brand note, e.g. "Vendor X", "Bottles given to ABC Caterers"

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month])
  @@index([groupId])
  @@index([subItem])
}

model RentAgreement {
  id                Int       @id @default(autoincrement())
  premises          String
  address           String    @default("")
  agreementDate     DateTime?
  validTill         DateTime?
  noOfYears         Int?
  ownerName         String    @default("")
  monthlyRent       Float?
  deposit           Float?
  additionalRemarks String    @default("")
  status            String    @default("")

  // Whether this record should appear in the reminders feed / dashboard
  // expiry stats. Defaults to true but is auto-suggested off in the UI when
  // the record's own status field reads Closed/Close/Surrendered (a closed
  // site or contract doesn't need an expiry chased) — still manually
  // overridable per record, e.g. a closed site that still needs one follow-up.
  needsReminder Boolean @default(true)

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([validTill])
}

// ---- SubModule: "Vegetable & Produce Purchase" (Ketan, sub-module 3) ----
// Source: a 20-sheet workbook covering ~14 months of daily purchases. Real
// structure found on reading it (2026-08-29): a fixed 70-item vegetable/
// fruit master list (order must never change — other sheets/links depend
// on it), daily purchase entries against that list tagged by vendor (the
// vendor "slots" the user calls Jakir/Raju — count varies over time, 1
// vendor before May-26, 2 from May-26 on, could grow to 3-4), a separate
// Potato/Onion/Garlic bill register with its own fields, and two lump-sum-
// only daily categories (Fruit & Cash Purchase, Onion & Garlic Flakes)
// that were never tracked item-by-item in the source and stay that way
// here per the user's explicit choice.

model VegetableItem {
  id        Int      @id @default(autoincrement())
  srNo      Int      @unique // preserves the original Sr. No. — append-only, never renumbered
  name      String   @unique
  createdAt DateTime @default(now())

  purchases VegetablePurchaseEntry[]
}

// Shared by both vegetable purchases and the Potato/Onion register — an
// editable company list, same "Vendor Master" pattern as the Asset
// Management tool (one list, not split per domain).
model VegetableVendor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  purchases       VegetablePurchaseEntry[]
  potatoOnionBuys PotatoOnionEntry[]
}

// One row per item purchased from one vendor on one day. Several of these
// naturally exist for the same day (different items, sometimes the same
// item from a different vendor) — this is intentionally granular, matching
// the source's daily Qty/Rate/Amt entries, not a monthly rollup.
model VegetablePurchaseEntry {
  id       Int             @id @default(autoincrement())
  date     DateTime
  itemId   Int
  item     VegetableItem   @relation(fields: [itemId], references: [id])
  vendorId Int
  vendor   VegetableVendor @relation(fields: [vendorId], references: [id])
  quantity Float // Kg (or the item's natural unit — the source doesn't vary units per item)
  rate     Float
  amount   Float // = quantity * rate, computed at write time, never typed directly
  remarks  String          @default("") // e.g. quality issue, a debit applied against this line — entered once per day+vendor batch, same value copied onto every line saved together

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([itemId])
  @@index([vendorId])
}

// Separate from VegetablePurchaseEntry because the source register tracks
// genuinely different fields (bill/receipt paperwork, not just a purchase
// line) — kept in full per the user's explicit choice (2026-08-29) rather
// than simplified down to match the vegetable entry shape.
model PotatoOnionEntry {
  id                   Int              @id @default(autoincrement())
  billNo               String           @default("")
  billDate             DateTime?
  materialReceivedDate String           @default("") // free text in the source (e.g. "29-07-2025 Morning") — kept as-is, not a clean date
  vendorId             Int?
  vendor               VegetableVendor? @relation(fields: [vendorId], references: [id])
  source               String           @default("") // broker/contact name
  item                 String // Potato / Onion / Garlic / Baby Potato / ... — free text with suggestions, not a rigid master (small, stable list)
  quantity             Float?
  rate                 Float?
  amount               Float?
  closingStockNote     String           @default("")

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([billDate])
  @@index([item])
}

// "Fruit & Cash Purchase" and "Onion & Garlic Flakes" — lump-sum-only in
// the source (no item-level breakdown), kept that way per the user's
// explicit choice (2026-08-29) to keep entry simple.
model CashPurchaseEntry {
  id       Int      @id @default(autoincrement())
  date     DateTime
  category String // "Fruit & Cash Purchase" | "Onion & Garlic Flakes"
  amount   Float
  remarks  String   @default("")

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// Admin's private monthly meal count (Lunch+Dinner plates served company-wide)
// — the one figure in the admin vegetable-cost dashboard that isn't derived
// from Ketan's purchase data, since nothing else in the system tracks it.
// Drives all "per plate" ratios (grams of veg/potato/onion per meal).
model MonthlyMealCount {
  id        Int      @id @default(autoincrement())
  monthKey  String   @unique // "YYYY-MM"
  countLD   Int
  enteredBy String   @default("")
  updatedAt DateTime @updatedAt
}

// ---- SubModule: "Roti / Meal Count" (Kiran Parmar) ----
// Daily count of Roti/Paratha/Poori/Thepla served, per site, per meal.
// Source: a wide per-day Excel sheet (one row per date, one column per
// site×meal×category) — normalized here into one line item per (day, site,
// meal, category) so sites/meals/categories can be added or removed later
// without a schema change (per the user's explicit "give option to add/
// delete" request for all three masters). The per-site and per-category
// totals the source sheet computed via formulas are NOT stored — they're
// derived live from RotiLineItem (app/lib/rotiSummary.ts) so they can never
// drift out of sync with the raw entries the way copy-pasted Excel formulas
// could.
model RotiSite {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lines RotiLineItem[]
}

model RotiMealType {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Lunch / Dinner
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lines RotiLineItem[]
}

model RotiCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique // Roti / Paratha / Poori / Thepla
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lines RotiLineItem[]
}

// One row per day. `remarks` matches the single free-text Remark column in
// the source sheet (one note per day, not per site).
model RotiDayEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  remarks   String   @default("")
  enteredBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines RotiLineItem[]
}

model RotiLineItem {
  id         Int          @id @default(autoincrement())
  dayEntryId Int
  dayEntry   RotiDayEntry @relation(fields: [dayEntryId], references: [id], onDelete: Cascade)
  siteId     Int
  site       RotiSite     @relation(fields: [siteId], references: [id])
  mealTypeId Int
  mealType   RotiMealType @relation(fields: [mealTypeId], references: [id])
  categoryId Int
  category   RotiCategory @relation(fields: [categoryId], references: [id])
  quantity   Float

  @@unique([dayEntryId, siteId, mealTypeId, categoryId])
  @@index([dayEntryId])
}

// ---- SubModule: "Vendor Payment" (Sandip Prajapati, Finance & Accounts) ----
// Replaces the "Vendor Payment_NCS" Excel register. Mirrors the real
// two-step workflow the user described (2026-09-12): Sandip raises a
// request (vendorName..remarksFinance below — his "Column A-G" fields),
// Admin fills approvedAmount + datePaid (his "Column H/I") and is the only
// one who flips status Open->Closed. Field-level write permission is
// enforced in the API (app/api/vendor-payment), not just in the UI, so a
// non-admin can't set the admin-only fields by calling the API directly.
model VendorPaymentEntry {
  id             Int    @id @default(autoincrement())
  vendorName     String
  vendorType     String @default("") // "Type of Vendor" in the source — a free-text category, not a rigid master (102 distinct values seen)
  bankName       String @default("") // "Name as per Bank" — often identical to vendorName but occasionally differs
  contactDetails String @default("")

  outstandingAmount Float? // "Total Outstanding with NCS" — context only, not part of any calculation here
  amount            Float // "Proposed Payment by Finance" — what Sandip is requesting
  paymentDate       DateTime // "Proposed Date of Payment by Finance" — the "total per day" summary groups on this
  paymentType       String   @default("NEFT") // NEFT | Cheque

  approvedAmount Float? // "Approved Payment by Mgt." — Admin-only field, can differ from `amount` (partial payment)
  datePaid       DateTime? // "Date of Payment by Mgt." — Admin-only field, set when actually paid

  urgency String @default("Normal") // "Normal" | "Urgent" — set by Sandip when raising the request
  status  String @default("Open") // "Open" | "Closed" — Admin-only to change, once approvedAmount/datePaid are in

  remarksFinance String @default("") // Sandip's remarks
  remarksAdmin   String @default("") // Admin's remarks

  enteredBy   String   @default("")
  importBatch String   @default("") // set on rows bulk-imported from the historical Excel register, blank for entries made in-app
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paymentDate])
  @@index([status])
}

// ---- SubModule: "Miscellaneous Expenses" (Company Expenses module) ----
// One row per month (amount + the free-text bifurcation the Excel carries
// in its Remarks column). Uploaded from Excel by Admin; re-uploading a
// month updates it (month is unique). Queries hang off a month: Admin or
// Rajiv raise them, the finance manager (Sandip) answers and closes.
model MiscExpense {
  id          Int      @id @default(autoincrement())
  month       DateTime @unique // normalized to the 1st of the month, UTC
  amount      Float
  remarks     String   @default("") // multi-line breakdown, newlines preserved
  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  queries MiscExpenseQuery[]
}

model MiscExpenseQuery {
  id           Int         @id @default(autoincrement())
  expenseId    Int
  expense      MiscExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  question     String
  raisedBy     String // username
  raisedByName String
  raisedAt     DateTime    @default(now())
  status       String      @default("Open") // "Open" | "Closed"
  response     String      @default("")
  respondedBy  String      @default("") // display name of whoever closed it
  closedAt     DateTime?

  @@index([expenseId])
  @@index([status])
}

// ---- SubModule: "Kitchen Weekly MIS" (Alkesh Reports module, Alkesh Labana) ----
// Source: a 10-sheet weekly working file he prepares mid-month from vendor
// invoices and stock checks — approximate on purpose, a pulse check, not a
// reconciled figure (2026-09-23). Two of his ten sheets are dropped entirely
// here: Roti and Vegetable are sourced live from Kiran's RotiLineItem and
// Ketan's Vegetable data instead of a duplicate entry, since both are
// already tracked there first-hand. Gas/Oil/Provision stay as Alkesh's own
// entries here even though Ketan separately tracks the same commodities
// monthly in Purchase & Consumption Costing — deliberately NOT linked
// (user's explicit choice, 2026-09-23): Alkesh's numbers are an early,
// rougher mid-month view; Ketan's are the month-end reconciled one. All
// analysis/report views built on this data are Admin-only for now (user's
// explicit instruction) — Alkesh only gets the entry screens.

// MRP sheet + MRP MIS sheet combined into one entry: MRP MIS was just the
// same transactions flattened for a pivot table, not separate data.
model AlkeshMrpEntry {
  id         Int      @id @default(autoincrement())
  date       DateTime
  vendorName String
  category   String // Biscuit / Chocolate / Cold Drink / Ice Cream / Juice / Namkeen / ... free text w/ suggestions, matches source's ad hoc list
  site       String // IBPL / INOX / Intas Matoda / SEZ Intas / TTEC / ... free text w/ suggestions
  amount     Float
  remarks    String   @default("")

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([site])
}

// Milk sheet, simplified. `teaQty`/`pantryQty` replace what used to be a
// plain milk figure plus a manually-remembered cell comment noting how much
// went to Pantry — now a structured split so the per-cup tea ratio never
// has to be corrected by hand again. Curd and Buttermilk have no tea/pantry
// distinction (that split is milk-specific), so they're single quantities.
model AlkeshMilkEntry {
  id            Int      @id @default(autoincrement())
  date          DateTime
  site          String // Sez / Amneal / Intas / IBPL / Unison / Ttec / Finar / Veeglow / O2H / Inox Solar / CK ... free text w/ suggestions
  milkTeaQty    Float    @default(0) // Ltr, used for tea/coffee
  milkPantryQty Float    @default(0) // Ltr, diverted to Pantry — excluded from the tea per-cup ratio
  curdQty       Float    @default(0) // Kg
  buttermilkQty Float    @default(0) // pcs
  remarks       String   @default("")

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([site])
}

// Gas, Oil, and the six Provision items (Atta/Rice/Besan/Maida/Sugar/Toor
// Dal) share one shape — Date + Qty + Rate + Amt — so one model covers all
// of them, keyed by `category`. Allowed values live in app/lib/alkeshMeta.ts,
// not a separate master table — small, fixed list, same pattern as
// PurchaseGroup.subItemsCsv elsewhere in this schema.
model AlkeshCommodityEntry {
  id       Int      @id @default(autoincrement())
  date     DateTime
  category String // "Gas" | "Oil" | "Atta" | "Rice" | "Besan" | "Maida" | "Sugar" | "Toor Dal"
  quantity Float?
  rate     Float?
  amount   Float
  remarks  String   @default("")

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// Admin-settable monthly targets shown against actuals on the Weekly MIS
// report — mirrors the Target row Alkesh's sheet already had, but editable
// instead of retyped every month. One row per tracked line; a line with no
// row here just shows no target, same as the source left some blank.
model AlkeshWeeklyTarget {
  id            Int      @id @default(autoincrement())
  category      String   @unique // "MRP" | "Milk" | "Gas" | "Provision" | "Vegetable" | "Curd" | "Buttermilk"
  monthlyTarget Float
  updatedAt     DateTime @updatedAt
}

// ---- Costing Reference (Farsan, Sweets, ...) — Admin-only ----
// Source: standalone per-item costing sheets (e.g. "Farsan Cost PP"), not
// tied to any employee's module — a personal reference the user keeps and
// updates as vendor rates change (2026-09-23: "rates are subject to change
// and may not be exact but I want these details to be available"). Derived
// figures (cost per person, wastage, total) are computed live in
// app/lib/costingCalc.ts from `ratePerUnit`, never stored, so editing the
// rate recalculates everything instead of going stale like the source
// sheet's copy-pasted formulas would.
model CostingItem {
  id       Int    @id @default(autoincrement())
  category String // "Farsan" | "Sweets" | ... free text w/ suggestions, more added the same way as they're shared
  name     String

  ratePerUnit          Float // ₹ per Kg or per Piece, whichever costBasis below applies
  servingQtyLabel      String @default("") // "70 gm", "2 Nos." — kept as typed, not parsed
  servingsPerUnitLabel String @default("") // "14 Persons", "1 Person" — kept as typed
  // How ratePerUnit turns into a per-person cost — the source sheet used two
  // different formulas depending on whether an item is sold by weight
  // (divide rate by servings-per-kg) or by piece (multiply rate by pieces
  // per serving), e.g. Dhokla = rate/14 but Chinese Samosa = rate*2.
  costBasis        String @default("PER_KG") // "PER_KG" (divide by conversionFactor) | "PER_PIECE" (multiply by conversionFactor)
  conversionFactor Float  @default(1)
  wastagePct       Float  @default(10)

  countPerPlate      String @default("") // "2 NOS", "-", free text
  accompanimentsCost Float? // null = not yet costed ("Pending" in the source)
  tadkaCost          Float? // null = not yet costed

  // The date these rates were actually worked out — distinct from
  // createdAt/updatedAt (which are just row audit timestamps). Editable, so
  // when the user revises a rate later they can set this to the new
  // as-of date and keep a real sense of "when did this last change" even
  // though old values aren't kept as history (2026-09-23, user's request:
  // "so in future if these things change I have the perspective of the same").
  asOfDate DateTime @default(now())

  sortOrder Int    @default(0)
  remarks   String @default("")

  enteredBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Sweets costing works differently from Farsan — a full ingredient list per
// recipe (batch cost ÷ batch qty = cost per unit, × a serving fraction),
// not a single rate — so it gets its own two models instead of forcing it
// into CostingItem's shape. Verified against the source sheet (2026-09-23):
// this same formula, with the source's own wastage line included as just
// another ingredient row, reproduces every one of its 9 sweets' final
// per-serving figures exactly.
model CostingRecipe {
  id       Int    @id @default(autoincrement())
  category String // "Sweets" — same free-text-category pattern as CostingItem
  name     String

  batchQty                Float // the denominator the source itself divided by, e.g. 550 (Kg), 11500 (wastage-adjusted Nos)
  batchUnit               String @default("KG") // "KG" | "Nos" | "Ltr" — as typed
  servingLabel            String @default("") // "70 GM", "1 Pc (35g)" — as typed
  servingConversionFactor Float  @default(1) // multiplies cost-per-batchUnit to get cost-per-serving (0.07 for 70gm-from-Kg, 1 when batchUnit already is the serving unit)

  asOfDate DateTime @default(now())
  remarks  String   @default("")

  sortOrder Int    @default(0)
  enteredBy String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients CostingRecipeIngredient[]

  @@index([category])
}

model CostingRecipeIngredient {
  id       Int           @id @default(autoincrement())
  recipeId Int
  recipe   CostingRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  qtyLabel String        @default("") // "150 KG", "90 LIT", "4 Person" — free text as typed, not parsed
  amount   Float
  sortOrder Int          @default(0)

  @@index([recipeId])
}

// ---- "Monthly Rent" (Ketan Reports module) ----
// Source: a 104-party workbook with ~135 monthly payment columns going back
// to 2015, mixing real amounts with status text ("Paid", "CLOSE") in the
// same cells — too inconsistent to import as structured history, and not
// what was actually asked for. Only the master fields (name, site, rent
// type, TDS, mode/timing of pay, mobile, active status) are imported here;
// the payment workflow below is for the ongoing/forward cycle only
// (2026-09-24, user's framing: "Ketan uploads... sends it to me for the
// payment before the due date").
//
// Visibility is deliberately narrow — Admin, Ketan, and Sandip only (user's
// explicit instruction) — and NOT done via the ordinary Module/SubModule
// access system, or even a "whoever holds this module" seat check: Rajiv
// already holds a real UserModuleAccess row on "Ketan Reports" itself (his
// separate "everything except Vendor Payment" grant), so either approach
// would leak this in to him too. Resolved instead in
// app/lib/monthlyRentAccess.ts by username.
model RentParty {
  id        Int     @id @default(autoincrement())
  srNo      Int? // preserves the source's Sr. No. where known — new parties added later get none
  partyName String
  siteName  String  @default("")
  typeOfPay String  @default("") // House Rent / Car Rent / Kitchen Rent / ... free text w/ suggestions
  amount    Float? // base rent, before TDS
  tdsDeduction Float @default(0)
  netPay    Float? // kept as its own editable field rather than force-derived — the source sometimes typed it independently of Amount - TDS
  modeOfPay String  @default("") // "Net Banking" | "Cheque" | ...
  approxDateOfPay String @default("") // "5 to 10 of Month" — free text as in the source, not a real date
  mobileNo  String  @default("")
  status    String  @default("ACTIVE") // "ACTIVE" | "NOT ACTIVE" — only ACTIVE parties go through the payment workflow

  // Not in the source — the user's explicit new requirement (2026-09-24):
  // "so that we can remember this for future reference" once a tenancy ends.
  depositDate   DateTime?
  depositAmount Float?

  remarks     String   @default("")
  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments RentPaymentEntry[]

  @@index([status])
}

// One row per payment cycle Ketan or Sandip sends to Admin — same two-step
// shape as VendorPaymentEntry (raise -> approve & pay -> close), just with
// two possible raisers instead of one.
model RentPaymentEntry {
  id      Int       @id @default(autoincrement())
  partyId Int
  party   RentParty @relation(fields: [partyId], references: [id])

  dueDate        DateTime // pay by this date
  rentMonth      DateTime // which month's rent this is for — normalized to the 1st, UTC (2026-09-24, user's explicit request)

  // Cost breakdown Ketan/Sandip enters by hand (2026-09-24, user's explicit
  // request) — proposedAmount below is "Net Payable" = basicPay + gst - tds
  // + extraPay - extraDedn, computed live in the UI but stays a plain
  // editable field here so it can be overridden if something was missed.
  basicPay  Float @default(0)
  gst       Float @default(0)
  tds       Float @default(0)
  extraPay  Float @default(0)
  extraDedn Float @default(0)

  proposedAmount Float // "Net Payable" — what Ketan/Sandip is asking to be paid this cycle
  remarksRequester String @default("") // ad hoc deduction/addition note from whoever raised it, e.g. "deduct 500 for water damage"

  raisedBy     String   @default("") // username
  raisedByName String   @default("")
  raisedAt     DateTime @default(now())

  status        String    @default("Open") // "Open" | "Closed"
  paidAmount    Float?
  datePaid      DateTime?
  remarksAdmin  String    @default("") // Admin's own note, e.g. why the paid amount differs from proposed
  paidBy        String    @default("") // display name of whoever closed it
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([status])
  @@index([dueDate])
}
