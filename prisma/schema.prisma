// Four independent expiry dates per vehicle — Agreement, Insurance, PUC,
// Fitness — each tracked and reminded on separately, since they renew on
// different cycles.
model VehicleAgreement {
  id          Int    @id @default(autoincrement())
  vehicleNo   String
  vehicleType String @default("")
  location    String @default("")
  site        String @default("")

  agreementStart DateTime?
  agreementEnd   DateTime?
  insuranceStart DateTime?
  insuranceEnd   DateTime?
  pucStart       DateTime?
  pucEnd         DateTime?
  fitnessEnd     DateTime?

  registrationDate DateTime?
  usedFor          String    @default("")
  ownerName        String    @default("")
  active           String    @default("Active") // Active / Close, as recorded in the source sheet

  // Whether this record should appear in the reminders feed / dashboard
  // expiry stats. Defaults to true but is auto-suggested off in the UI when
  // the record's own status field reads Closed/Close/Surrendered (a closed
  // site or contract doesn't need an expiry chased) — still manually
  // overridable per record, e.g. a closed site that still needs one follow-up.
  needsReminder Boolean @default(true)

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

