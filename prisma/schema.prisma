// viral-mis: NCS India's internal MIS, replacing per-person Excel trackers.
// Modules are named after the employee/responsibility area currently owning
// that reporting domain (e.g. "Ketan Reports") — module identity lives in
// the Module table, not in code, since these names/owners can change.
// Each Module can hold several SubModules (one Excel workbook = one
// SubModule); the concrete data tables per SubModule are bespoke, since
// different SubModules track completely different things.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  // Global read-only pass — sees every module's data and reports, same as
  // Admin's own viewing rights, but never bypasses a write/edit/delete
  // check anywhere (those still require real UserModuleAccess or isAdmin).
  // For a person who should see everything company-wide without becoming
  // a second admin — e.g. Sandip, 2026-09-23.
  isViewer     Boolean  @default(false)
  createdAt    DateTime @default(now())

  moduleAccess UserModuleAccess[]
}

model Module {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  subModules SubModule[]
  userAccess UserModuleAccess[]
}

// Join table: which users can enter data / see the dashboard for which
// Module. Many-to-many per 2026-08-29 decision (an employee can be assigned
// to more than one module). Admin users bypass this entirely (see full app
// access regardless of rows here) — enforced in app/lib/authz.ts.
model UserModuleAccess {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model SubModule {
  id       Int    @id @default(autoincrement())
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name     String
  slug     String @unique // used in routes, e.g. "ketan-compliance"

  createdAt DateTime @default(now())

  @@unique([moduleId, name])
}

// ---- SubModule: "Agreements, Licenses & Insurance" (Ketan, sub-module 1) ----
// One Prisma model per source Excel tab. Every model carries a Start/End
// (or equivalent) date pair so the shared expiry-status + reminders logic
// (app/lib/expiry.ts) can compute Active / Expiring Soon / Expired the same
// way across all of them. Field names are normalized; Excel's original
// inconsistent "Status" text (Yes/No/NA/Closed/Active) is kept as free text
// for reference but is no longer the source of truth for expiry state.

model ClientAgreement {
  id           Int       @id @default(autoincrement())
  siteName     String
  location     String    @default("")
  contractType String    @default("")
  siteStatus   String    @default("") // Active / Closed (site's overall contract status)
  startDate    DateTime?
  endDate      DateTime?
  remarks      String    @default("")

  // Whether this record should appear in the reminders feed / dashboard
  // expiry stats. Defaults to true but is auto-suggested off in the UI when
  // the record's own status field reads Closed/Close/Surrendered (a closed
  // site or contract doesn't need an expiry chased) — still manually
  // overridable per record, e.g. a closed site that still needs one follow-up.
  needsReminder Boolean @default(true)

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([endDate])
}

model FoodLicense {
  id           Int       @id @default(autoincrement())
  siteName     String
  location     String    @default("")
  contractType String    @default("")
  siteStatus   String    @default("")
  hasLicense   String    @default("") // Yes / No / NA as recorded in the source sheet
  startDate    DateTime?
  endDate      DateTime?

  // Whether this record should appear in the reminders feed / dashboard
  // expiry stats. Defaults to true but is auto-suggested off in the UI when
  // the record's own status field reads Closed/Close/Surrendered (a closed
  // site or contract doesn't need an expiry chased) — still manually
  // overridable per record, e.g. a closed site that still needs one follow-up.
  needsReminder Boolean @default(true)

  enteredBy   String   @default("")
  importBatch String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([endDate])
