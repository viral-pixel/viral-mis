model LabourLicense {
  id            Int       @id @default(autoincrement())
  siteName      String
  location      String    @default("")
  contractType  String    @default("")
  siteStatus    String    @default("")
  licenseStatus String    @default("") // NR / YES etc. as recorded in the source sheet
  startDate     DateTime?
  endDate       DateTime?
  licenseNo     String    @default("")
